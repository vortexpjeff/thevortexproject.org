<main>
{% set records = editorial.publications if build.preview else editorial | publicPublications %}
<section class="masthead"><div><p class="eyebrow">Institute archive{% if build.preview %} · preview records{% endif %}</p><h1>Dispatch<span>archive</span></h1><p class="masthead-copy">Field notes, science watch, open builds, and release records share one provenance-aware publication contract.</p></div><aside class="issue"><div class="issue-line"><span>Records</span><b>{{ records | length }}</b></div><p class="issue-state">{% if build.preview %}Preview records are not indexed.{% else %}Only released public records appear here.{% endif %}</p></aside></section>
<section class="stream"><div class="stream-grid">
{% for item in records %}<a class="story" href="/dispatches/{{ item.slug }}/"><small>{{ item.stream }} · {{ item.editorial_state }}</small><h3>{{ item.title }}</h3><p>{{ item.summary }}</p></a>{% else %}<article class="story"><small>Archive</small><h3>No released Dispatches yet</h3><p>Records appear here only after public release.</p></article>{% endfor %}
</div></section>
</main>
