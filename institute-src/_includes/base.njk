<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#020806">
<meta name="description" content="{{ description }}">
<meta name="robots" content="{{ build.robots }}">
<link rel="canonical" href="https://www.thevortexproject.org{{ canonicalPath }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/institute.css">
<title>{{ title }}</title>
</head>
<body data-build-mode="{{ build.mode }}" data-editorial-state="{% if build.preview %}fixture{% else %}public{% endif %}">
{% if build.preview %}<div class="prototype-flag">Editorial preview · not published</div>{% endif %}
<header class="site-head">
  <a class="brand" href="/" aria-label="The Vortex Project home"><span class="mark">◉</span><span class="brand-copy"><strong>THE VORTEX PROJECT</strong><small>independent field institute</small></span></a>
  <nav class="head-nav" aria-label="Project views"><a href="/">Field</a><a href="/weather.html">Weather</a><a href="/observatory.html">Observatory</a><a href="/cartographer.html">Cartographer</a><span aria-current="page">Institute</span></nav>
</header>
<nav class="institute-nav" aria-label="Institute sections"><strong>Institute / 05</strong><div><a href="/institute/">Institute</a><a href="/dispatches/">Dispatches</a><a href="/institute/#research">Research</a><a href="/institute/#releases">Releases</a><a href="/institute/#methods">Methods</a></div></nav>
{{ content | safe }}
<footer><span>{% if build.preview %}Editorial preview · no public claims{% else %}The Vortex Project · independent field institute{% endif %}</span><span>Field · evidence · release · context · correction</span></footer>
</body>
</html>
